{
  "name": "dsh-video-workbench",
  "version": "0.3.1",
  "description": "DeepSeek Harness 多智能体双引擎视频工作台：Opus 5.5 级 Vibecoding (Remotion 4.x + Three.js 3D + 动态 SVG 架构图 + HUD 数据面板 + 节拍同步弹簧物理)、48kHz 踩点混音与多引擎配音。",
  "license": "MIT",
  "author": "Merziller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Merziller/dsh-video-workbench.git"
  },
  "homepage": "https://github.com/Merziller/dsh-video-workbench#readme",
  "bugs": {
    "url": "https://github.com/Merziller/dsh-video-workbench/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./packages/dsh-web-video-workbench/lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "packages/shared",
    "packages/dsh-tool-local-tts",
    "packages/dsh-tool-avatar",
    "packages/dsh-tool-video-suite",
    "packages/dsh-tool-media",
    "packages/dsh-preset-video",
    "packages/dsh-web-video-workbench",
    "scripts/tts-bridge.py",
    "scripts/tts-server.py",
    "voice-packs/README.md",
    "voice-packs/catalog.example.json",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "dsh": "node ./scripts/dsh-runner.mjs",
    "dsh:video": "node ./scripts/dsh-runner.mjs video",
    "setup:profile": "node ./scripts/install-profile.mjs",
    "pack:bundle": "node ./scripts/pack-bundle.mjs",
    "test": "node ./scripts/self-test.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@react-three/fiber": "^8.18.0",
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "@remotion/three": "4.0.542",
    "@types/react": "^18.3.31",
    "@types/three": "^0.170.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.542",
    "three": "^0.170.0",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "remotion",
    "threejs",
    "vibecoding",
    "gsap",
    "ffmpeg",
    "video",
    "indextts",
    "gpt-sovits",
    "video-workbench"
  ]
}
